@model List<Movie>

<h1>Joel Hilton's Movie List</h1>

<table class="table table-striped table-bordered">
    <thead>
    <tr>
        <th>Category</th>
        <th>Title</th>
        <th>Year</th>
        <th>Director</th>
        <th>Rating</th>
        <th>Edited</th>
        <th>LentTo</th>
        <th>CopiedToPlex</th>
        <th>Note</th>
        <th></th>
    </tr>
    </thead>
    
    <tbody>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.Category?.CategoryName</td>
            <td>@m.Title</td>
            <td>@m.Year</td>
            <td>@m.Director</td>
            <td>@m.Rating</td>
            <td>@m.Edited</td>
            <td>@m.LentTo</td>
            <td>@m.CopiedToPlex</td>
            <td>@m.Notes</td>
            <td>
                <a class="btn btn-sm btn-info" asp-controller="Home" asp-action="Edit" asp-route-id="@m.MovieId">Edit</a>
                <a class="btn btn-sm btn-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@m.MovieId">Delete</a>
            </td>
        </tr>
        
    }
    </tbody>
    
    
    
</table>